  "narrative": {
    "northStar": "The Pad Paper Storybook",
    "overview": "The child's page becomes their own pad paper. Reading text sits on quiet blue rules with one red margin line, warm off-white paper, deep navy ink, and every word can be tapped. Saturated book-jacket cloth (indigo, mango, kangkong green, gumamela red) acts as the notebook cover and owns whole regions. Rewards are rubber-stamp stars and teacher check marks, never confetti. The owl mascot is the only character.\n\nThe system is calm and low-density: one thing burns brightest at a time. Sunrise orange marks the single primary action and the tapped word. It refuses the category default of candy-gradient cards, emoji chrome and stacked stat tiles. Dark mode is a night pad under one bulb, same structure with lowered paper.",
    "keyCharacteristics": [
      "Real baseline grid: the rule pitch equals the reading line-height at every font-size setting.",
      "Warm paper neutrals, navy ink, flat cloth-colored jackets, one orange accent.",
      "State by shape first (circle/square/triangle difficulty stamps), color only reinforces.",
      "Offline-to-AI upgrades restyle in place with reserved space, no layout shift.",
      "Motion is transform and opacity only, 150-300ms, once per flow, off under reduced motion.",
      "Large targets (44px minimum, 48-60px for actions) for ages 6-12."
    ],
    "rules": [
      {
        "name": "The One Burner Rule",
        "body": "Orange goes on the single primary action per screen and the tapped word. The raised Scan button in the nav is a deliberate, user-approved second occurrence; do not extend that exception.",
        "section": "colors"
      },
      {
        "name": "The Mixed-Tint Rule",
        "body": "Reading overlays are mixed into the paper at 12-16% and never laid over text. Contrast is asserted in src/styles/contrast.test.ts.",
        "section": "colors"
      },
      {
        "name": "The Baseline Rule",
        "body": "Reading text uses .pad-text, whose line-height is the rule pitch; sizes are rem-based so pitch and text scale together.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Labels are sentence case, bold, small. No uppercase tracked labels.",
        "section": "typography"
      },
      {
        "name": "The Soft Navy Shadow Rule",
        "body": "Shadows are blurred, offset-down, and navy-tinted. No hard offset shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do read tokens only from the CSS custom properties / Tailwind utilities (bg-paper, text-ink, bg-sunrise, shadow-cta).",
      "Do lay reading text on .pad / .pad-text so line-height equals the rule pitch.",
      "Do pair every difficulty color with its shape and label.",
      "Do use ink navy text on sunrise and mango, white on indigo, kangkong, and gumamela.",
      "Do gate every GSAP helper on reduced motion and animate only transform and opacity.",
      "Do reserve space for content that upgrades in place."
    ],
    "donts": [
      "Don't add a second sunrise action on a screen beyond the nav Scan button.",
      "Don't use candy gradients, stacked stat tiles, or emoji as chrome.",
      "Don't convey state by color alone.",
      "Don't put a color overlay over text; mix it into the paper.",
      "Don't use hard offset shadows or glow."
    ]
  }
