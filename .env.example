# Copy to .env.local (local) or set in the Vercel project settings. Never commit real keys.
# These are server-side only, except NEXT_PUBLIC_API_BASE.

# Gemini API key used by the /api proxy (word explanations and OCR). Server-side only.
GEMINI_API_KEY=

# Gemini model id. Optional; defaults to gemini-flash-latest.
GEMINI_MODEL=gemini-flash-latest

# Upstash Redis REST URL for per-IP rate limiting. Required in production (requests fail closed without it).
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token for rate limiting.
UPSTASH_REDIS_REST_TOKEN=

# Extra allowed CORS origins, comma-separated. https://localhost and capacitor://localhost are always allowed.
ALLOWED_ORIGINS=

# Base URL the client uses for /api calls. Empty = same-origin (web). Set to the deployed URL for the Capacitor build, e.g. https://your-app.vercel.app
NEXT_PUBLIC_API_BASE=
